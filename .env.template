# Environment template for the Healthcare Media Network.
# Copy to .env and fill in real values. NEVER commit .env or expose secrets in browser code.
# The static build itself needs NO secrets; these are for the services you connect at deploy time.

# --- Per-publication analytics / Search Console (client-side IDs are public by design) ---
DHN_GA_MEASUREMENT_ID=          # Google Analytics 4 measurement ID for digitalhealthnews
HTI_GA_MEASUREMENT_ID=          # healthtechinsider
PTJ_GA_MEASUREMENT_ID=          # ptpracticejournal
AAR_GA_MEASUREMENT_ID=          # appliedaireview
MPB_GA_MEASUREMENT_ID=          # medicalpracticebusiness

# Google Search Console verification tokens (one property per domain)
DHN_GSC_VERIFICATION=
HTI_GSC_VERIFICATION=
PTJ_GSC_VERIFICATION=
AAR_GSC_VERIFICATION=
MPB_GSC_VERIFICATION=

# --- Newsletter provider (server-side only; keep secret) ---
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# --- Editorial CMS (only if you upgrade from the file-based model to a hosted CMS) ---
# DATABASE_URL=
# AUTH_SECRET=
# ADMIN_EMAILS=

# --- Deployment (optional, if using a host's API) ---
# DEPLOY_TOKEN=
